{
  "name": "rento",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace web",
    "dev:api": "npm run dev --workspace api",
    "dev:worker": "npm run worker --workspace api",
    "build": "npm run build --workspace web && npm run build --workspace api",
    "test:api": "npm run test --workspace api",
    "test:web": "npm run test --workspace web",
    "test": "npm run test --workspace api && npm run test --workspace web",
    "test:e2e": "npm run test:e2e --workspace web",
    "db:generate": "npm run db:generate --workspace api",
    "db:push": "npm run db:push --workspace api",
    "db:seed": "npm run db:seed --workspace api"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  }
}
