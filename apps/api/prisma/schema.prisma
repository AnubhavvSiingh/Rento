generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  Furniture
  Appliances
  Fashion
  Ceremony
  Electronics
}

enum ProductCondition {
  Excellent
  Good
  Verified
}

enum UserRole {
  ADMIN
  ADVERTISER
}

enum AccessStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum ListingStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum BookingStatus {
  PLACED
  PACKED
  OUT_FOR_DELIVERY
  DELIVERED
  RETURN_PICKUP
  COMPLETED
  CANCELLED
}

enum QaStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PricingRuleType {
  WEEKDAY
  WEEKEND
  SEASONAL
  DEMAND
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ContentType {
  HERO
  FAQ
  POLICY
  BANNER
}

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  CHECKOUT_START
  BOOKING_COMPLETE
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum PaymentStatus {
  PAID
  REFUNDED
}

model Product {
  id          String           @id
  name        String
  category    Category
  city        String
  dailyRate   Int
  deposit     Int
  owner       String
  ownerId     String?
  condition   ProductCondition
  description String
  tags        String[]
  status      ListingStatus    @default(APPROVED)
  qaStatus    QaStatus         @default(PENDING)
  qaNotes     String?
  qaCheckedAt DateTime?
  leadTimeDays Int             @default(2)
  bufferDays  Int              @default(1)
  minPhotoCount Int            @default(3)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  ownerUser   User?            @relation("AdvertiserProducts", fields: [ownerId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  bookings    Booking[]
  reviews     Review[]
  availabilityBlocks AvailabilityBlock[]
  pricingRules PricingRule[]

  @@index([city])
  @@index([category])
  @@index([status])
  @@index([ownerId])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  sortOrder Int      @default(0)
  qualityScore Int   @default(0)
  autoTags  String[] @default([])
  isPrimary Boolean  @default(false)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String?
  role         UserRole
  accessStatus AccessStatus   @default(PENDING)
  provider     AuthProvider   @default(LOCAL)
  isVerifiedHost Boolean      @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     Session[]
  products     Product[]      @relation("AdvertiserProducts")

  @@index([role, accessStatus])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Customer {
  id           String            @id @default(cuid())
  fullName     String
  email        String            @unique
  phone        String
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     CustomerSession[]
  bookings     Booking[]
  reviews      Review[]
  notifications Notification[]

  @@map("customers")
}

model CustomerSession {
  id         String   @id @default(cuid())
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_sessions")
}

model Booking {
  id          String        @id @default(cuid())
  productId   String
  customerId  String
  dailyRate   Int
  deposit     Int
  totalAmount Int
  status      BookingStatus @default(PLACED)
  promoCode   String?
  discountAmount Int         @default(0)
  priceBreakdown Json?
  cancelReason String?
  cancelledAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  product     Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payment     Payment?
  shipment    Shipment?
  review      Review?
  shipmentEvents ShipmentEvent[]

  @@index([productId])
  @@index([customerId])
  @@index([status])
  @@map("bookings")
}

model Payment {
  id        String        @id @default(cuid())
  bookingId String        @unique
  method    String
  reference String
  amount    Int
  status    PaymentStatus @default(PAID)
  createdAt DateTime      @default(now())
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Shipment {
  id                   String   @id @default(cuid())
  bookingId            String   @unique
  addressLine1         String
  addressLine2         String?
  city                 String
  state                String
  postalCode           String
  shipmentDate         DateTime
  rentalStartDate      DateTime
  rentalEndDate        DateTime
  deliveryInstructions String?
  conditionPhotoUrl    String?
  returnScheduledAt    DateTime?
  trackingCode         String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  booking              Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([city])
  @@map("shipments")
}

model Review {
  id            String   @id @default(cuid())
  productId     String
  customerId    String
  bookingId     String   @unique
  rating        Int
  comment       String
  conditionNote String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([customerId])
  @@map("reviews")
}

model Notification {
  id         String    @id @default(cuid())
  customerId String
  title      String
  message    String
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("notifications")
}

model AvailabilityBlock {
  id        String   @id @default(cuid())
  productId String
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, startDate])
  @@map("availability_blocks")
}

model PricingRule {
  id             String          @id @default(cuid())
  productId      String
  label          String
  type           PricingRuleType
  multiplier     Float?
  fixedDailyRate Int?
  startDate      DateTime?
  endDate        DateTime?
  daysOfWeek     DayOfWeek[]    @default([])
  demandThreshold Int?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("pricing_rules")
}

model ShipmentEvent {
  id         String        @id @default(cuid())
  bookingId  String
  status     BookingStatus
  message    String
  occurredAt DateTime      @default(now())
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("shipment_events")
}

model ContentBlock {
  id          String      @id @default(cuid())
  key         String      @unique
  title       String
  body        String
  type        ContentType
  isPublished Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("content_blocks")
}

model PromoCampaign {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String
  discountType  DiscountType
  value         Int
  startsAt      DateTime
  endsAt        DateTime
  minOrderAmount Int?
  usageLimit    Int?
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@map("promo_campaigns")
}

model ReferralCode {
  id           String   @id @default(cuid())
  code         String   @unique
  rewardAmount Int
  usageCount   Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("referral_codes")
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  eventType  AnalyticsEventType
  sessionId  String?
  customerId String?
  productId  String?
  metadata   Json?
  createdAt  DateTime           @default(now())

  @@index([eventType])
  @@map("analytics_events")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@map("audit_logs")
}
